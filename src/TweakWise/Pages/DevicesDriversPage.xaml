<Page x:Class="TweakWise.Pages.DevicesDriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      PreviewKeyDown="Page_PreviewKeyDown"
      Title="Устройства и драйверы"
      Focusable="True"
      Background="{DynamicResource WindowBackground}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="DevicesBoardSurfaceBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="DevicesPanelBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="DevicesComponentBrush" Color="#232323"/>
        <SolidColorBrush x:Key="DevicesComponentHoverBrush" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="DevicesCalloutBrush" Color="#202020"/>
        <SolidColorBrush x:Key="DevicesBorderBrush" Color="#363636"/>
        <SolidColorBrush x:Key="DevicesTraceBrush" Color="#464646"/>
        <SolidColorBrush x:Key="DevicesLineBrush" Color="#6A6A6A"/>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource DevicesComponentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrbitArrowStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
        </Style>

        <Style x:Key="WorkspaceReturnOrbButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource CoreOrbForegroundBrush}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush Center="0.44,0.38" GradientOrigin="0.36,0.30" RadiusX="0.78" RadiusY="0.78">
                        <GradientStop Color="#F14FE8D8" Offset="0"/>
                        <GradientStop Color="#C531B9D0" Offset="0.44"/>
                        <GradientStop Color="#702D6EA7" Offset="0.78"/>
                        <GradientStop Color="#25203B54" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Margin="-7,24,-7,-9"
                                     Opacity="0.22">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.66" RadiusY="0.42">
                                        <GradientStop Color="#7A4FE8D8" Offset="0"/>
                                        <GradientStop Color="#243CC7B7" Offset="0.55"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="OuterRing"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"
                                     Opacity="0.34"/>
                            <Ellipse Margin="4"
                                     Fill="{TemplateBinding Background}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.34" Color="#3CC7B7"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="9" Opacity="0.24">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.36,0.30" GradientOrigin="0.22,0.18" RadiusX="0.92" RadiusY="0.92">
                                        <GradientStop Color="#D8FFFFFF" Offset="0"/>
                                        <GradientStop Color="#7A5DEBE2" Offset="0.30"/>
                                        <GradientStop Color="#2835A7C8" Offset="0.72"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Margin="14,10,19,23" Fill="#DFFFFFFF" Opacity="0.32"/>
                            <Ellipse Margin="20,20,15,15" Fill="#7EE9FFF7" Opacity="0.18"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrbButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="300"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailSignalStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DeviceSignalActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="DeviceWorkspaceFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CoreLineActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceWorkspaceFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource DeviceSignalActionButtonStyle}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="40,0,40,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailGroupStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,0,0,16"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style x:Key="WorkspaceSignalCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="WorkspaceInventoryCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="DeviceBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <LinearGradientBrush x:Key="SearchHighlightGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#254EA8FF" Offset="0"/>
            <GradientStop Color="#343CC7B7" Offset="0.46"/>
            <GradientStop Color="#1BFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="DeviceLoadingSquareStyle" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNormalBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.42" Color="#3CC7B7"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootContent" Background="{DynamicResource WindowBackground}" ClipToBounds="True" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,18,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Назад"
                    Click="BackButton_Click"/>

            <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ModuleStatusIndicator" Width="9" Height="9" Margin="0,1,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModuleStatusTextBlock" FontSize="13" FontWeight="SemiBold" Opacity="0.78"/>
                </StackPanel>
                <TextBlock Text="Устройства и драйверы" Margin="0,8,0,0" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#xE72C;"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Обновить диагностику"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,18" MaxWidth="1580" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="372"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="OrbitStage"
                  Grid.Row="0"
                  ClipToBounds="True"
                  MinHeight="320"
                  MaxHeight="350"
                  VerticalAlignment="Top"
                  PreviewMouseLeftButtonDown="OrbitStage_MouseLeftButtonDown"
                  PreviewMouseMove="OrbitStage_MouseMove"
                  PreviewMouseLeftButtonUp="OrbitStage_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PreviousModeButton"
                        Grid.Column="0"
                        Content="&#x2039;"
                        Style="{StaticResource OrbitArrowStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="PreviousModeButton_Click"/>

                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid x:Name="OrbitScene">
                        <Border Width="900"
                                Height="330"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource DevicesBoardSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="30"
                                Opacity="0.38"/>

                        <Canvas Width="900" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Line X1="116" Y1="170" X2="784" Y2="170" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="1" Opacity="0.18"/>
                            <Ellipse Canvas.Left="335" Canvas.Top="55" Width="230" Height="230" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="1" StrokeDashArray="8,9" Opacity="0.16"/>
                            <Ellipse Canvas.Left="300" Canvas.Top="25" Width="300" Height="300" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="1" Opacity="0.08"/>
                        </Canvas>

                        <Grid x:Name="OrbitTextureLayer" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="OrbitSceneScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="OrbitSceneTranslate" X="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                        <StackPanel x:Name="LeftGhost"
                                    Width="170"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="-390,0,0,0"
                                    Opacity="0.25"
                                    RenderTransformOrigin="0.5,0.5"
                                    IsHitTestVisible="False">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="LeftGhostScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="LeftGhostTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <Viewbox Width="122" Height="98" Stretch="Uniform" HorizontalAlignment="Center">
                                <Grid Width="180" Height="150">
                                    <Canvas x:Name="LeftGhostDriverGlyph" Width="180" Height="150">
                                        <Rectangle Canvas.Left="34" Canvas.Top="26" Width="112" Height="92" RadiusX="14" RadiusY="14" Fill="{DynamicResource DevicesBoardSurfaceBrush}" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="58" Canvas.Top="50" Width="64" Height="44" RadiusX="8" RadiusY="8" Fill="{DynamicResource DevicesComponentBrush}" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="2"/>
                                        <Line X1="68" Y1="62" X2="112" Y2="62" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="68" Y1="78" X2="100" Y2="78" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="42" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="65" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="88" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="144" Canvas.Top="42" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="144" Canvas.Top="65" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="144" Canvas.Top="88" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                    </Canvas>
                                    <Canvas x:Name="LeftGhostDeviceGlyph" Width="180" Height="150" Visibility="Collapsed">
                                        <Rectangle Canvas.Left="48" Canvas.Top="20" Width="84" Height="50" RadiusX="8" RadiusY="8" Fill="{DynamicResource DevicesBoardSurfaceBrush}" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="31" Canvas.Top="61" Width="118" Height="56" RadiusX="13" RadiusY="13" Fill="{DynamicResource DevicesBoardSurfaceBrush}" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="55" Canvas.Top="99" Width="70" Height="34" RadiusX="7" RadiusY="7" Fill="{DynamicResource DevicesComponentBrush}" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="118" Canvas.Top="76" Width="10" Height="10" Fill="{DynamicResource DevicesLineBrush}"/>
                                        <Line X1="67" Y1="111" X2="113" Y2="111" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="3" StrokeStartLineCap="Round"/>
                                        <Line X1="67" Y1="123" X2="104" Y2="123" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="3" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="LeftGhostTitle"
                                       Margin="0,10,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource WindowForeground}"/>
                        </StackPanel>

                        <StackPanel x:Name="RightGhost"
                                    Width="170"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="390,0,0,0"
                                    Opacity="0.25"
                                    RenderTransformOrigin="0.5,0.5"
                                    IsHitTestVisible="False">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="RightGhostScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="RightGhostTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <Viewbox Width="122" Height="98" Stretch="Uniform" HorizontalAlignment="Center">
                                <Grid Width="180" Height="150">
                                    <Canvas x:Name="RightGhostDriverGlyph" Width="180" Height="150">
                                        <Rectangle Canvas.Left="34" Canvas.Top="26" Width="112" Height="92" RadiusX="14" RadiusY="14" Fill="{DynamicResource DevicesBoardSurfaceBrush}" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="58" Canvas.Top="50" Width="64" Height="44" RadiusX="8" RadiusY="8" Fill="{DynamicResource DevicesComponentBrush}" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="2"/>
                                        <Line X1="68" Y1="62" X2="112" Y2="62" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="68" Y1="78" X2="100" Y2="78" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="42" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="65" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="88" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="144" Canvas.Top="42" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="144" Canvas.Top="65" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                        <Rectangle Canvas.Left="144" Canvas.Top="88" Width="18" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource DevicesTraceBrush}"/>
                                    </Canvas>
                                    <Canvas x:Name="RightGhostDeviceGlyph" Width="180" Height="150" Visibility="Collapsed">
                                        <Rectangle Canvas.Left="48" Canvas.Top="20" Width="84" Height="50" RadiusX="8" RadiusY="8" Fill="{DynamicResource DevicesBoardSurfaceBrush}" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="31" Canvas.Top="61" Width="118" Height="56" RadiusX="13" RadiusY="13" Fill="{DynamicResource DevicesBoardSurfaceBrush}" Stroke="{DynamicResource DevicesLineBrush}" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="55" Canvas.Top="99" Width="70" Height="34" RadiusX="7" RadiusY="7" Fill="{DynamicResource DevicesComponentBrush}" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="118" Canvas.Top="76" Width="10" Height="10" Fill="{DynamicResource DevicesLineBrush}"/>
                                        <Line X1="67" Y1="111" X2="113" Y2="111" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="3" StrokeStartLineCap="Round"/>
                                        <Line X1="67" Y1="123" X2="104" Y2="123" Stroke="{DynamicResource DevicesTraceBrush}" StrokeThickness="3" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="RightGhostTitle"
