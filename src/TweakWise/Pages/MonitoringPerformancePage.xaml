<Page x:Class="TweakWise.Pages.MonitoringPerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="clr-namespace:TweakWise.Models"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      PreviewKeyDown="Page_PreviewKeyDown"
      Title="Производительность и охлаждение"
      Focusable="True"
      Background="{DynamicResource WindowBackground}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardPartHitStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardNodeGlowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="BoardPartShellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.25"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Opacity" Value="0.97"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.14" Color="#05080D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BoardSmallLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.76"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BoardTraceLineStyle" TargetType="Line">
            <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
            <Setter Property="StrokeThickness" Value="0.95"/>
            <Setter Property="Opacity" Value="0.18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardTracePolylineStyle" TargetType="Polyline">
            <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Opacity" Value="0.20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardOutlineStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="StrokeThickness" Value="1.15"/>
            <Setter Property="Opacity" Value="0.28"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style x:Key="DiagnosticCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#05080D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="BoardToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MaxWidth" Value="300"/>
        </Style>

        <Style x:Key="PerformanceSettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.12" Color="#05080D"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PerformanceBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="PerformanceSearchBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="40,0,40,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="SearchHighlightGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#254EA8FF" Offset="0"/>
            <GradientStop Color="#343CC7B7" Offset="0.46"/>
            <GradientStop Color="#1BFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PerformanceLoadingSquareStyle" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNormalBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.42" Color="#3CC7B7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnergyOrbButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource CoreOrbForegroundBrush}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush Center="0.44,0.38" GradientOrigin="0.36,0.30" RadiusX="0.78" RadiusY="0.78">
                        <GradientStop Color="#F14FE8D8" Offset="0"/>
                        <GradientStop Color="#C531B9D0" Offset="0.44"/>
                        <GradientStop Color="#702D6EA7" Offset="0.78"/>
                        <GradientStop Color="#25203B54" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Margin="-7,24,-7,-9"
                                     Opacity="0.22">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.66" RadiusY="0.42">
                                        <GradientStop Color="#7A4FE8D8" Offset="0"/>
                                        <GradientStop Color="#243CC7B7" Offset="0.55"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="OuterRing"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"
                                     Opacity="0.34"/>
                            <Ellipse Margin="4"
                                     Fill="{TemplateBinding Background}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.34" Color="#3CC7B7"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="9" Opacity="0.24">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.36,0.30" GradientOrigin="0.22,0.18" RadiusX="0.92" RadiusY="0.92">
                                        <GradientStop Color="#D8FFFFFF" Offset="0"/>
                                        <GradientStop Color="#7A5DEBE2" Offset="0.30"/>
                                        <GradientStop Color="#2835A7C8" Offset="0.72"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Margin="14,10,19,23" Fill="#DFFFFFFF" Opacity="0.32"/>
                            <Ellipse Margin="20,20,15,15" Fill="#7EE9FFF7" Opacity="0.18"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PerformanceActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PerformancePrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PerformanceActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CoreOrbForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
        </Style>

        <Style x:Key="PerformanceSignalActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PerformanceActionButtonStyle}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>

        <Style x:Key="PerformanceFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CoreLineActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PerformanceComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                MinHeight="34"
                                                Background="{DynamicResource CoreNodeBackgroundBrush}"
                                                BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="10,6">
                                            <Grid>
                                                <TextBlock Margin="0,0,22,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource WindowForeground}"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.72"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.48"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="{DynamicResource ContentBackground}"
                                        BorderBrush="{DynamicResource CoreLineActiveBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PerformanceToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="56" Height="30" SnapsToDevicePixels="True">
                            <Border x:Name="Track"
                                    Width="54"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Fill="{DynamicResource WindowForeground}"
                                     Margin="5,0,5,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PerformanceSettingItemTemplate">
            <Border Style="{StaticResource PerformanceSettingCardStyle}"
                    Loaded="PerformanceSettingCard_Loaded"
                    Opacity="0">
                <Grid>
                    <Border Tag="SearchHighlightOverlay"
                            Margin="-6"
                            CornerRadius="10"
                            Background="{StaticResource SearchHighlightGradientBrush}"
                            BorderBrush="{DynamicResource CoreLineActiveBrush}"
                            BorderThickness="1"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" Margin="0,7,0,0" FontSize="12" LineHeight="18" Opacity="0.76" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PerformanceBadgeStyle}" Margin="10,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ChannelLabel}" FontSize="11" FontWeight="SemiBold" Opacity="0.78"/>
                        </Border>
                    </Grid>

                    <WrapPanel Margin="0,12,0,0">
                        <Border Visibility="{Binding HasActiveSignal, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PerformanceBadgeStyle}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource CoreNormalBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SignalLevel}" Value="{x:Static models:HealthLevel.Attention}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CoreAttentionBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SignalLevel}" Value="{x:Static models:HealthLevel.Warning}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CoreWarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SignalLevel}" Value="{x:Static models:HealthLevel.Critical}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CoreCriticalBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SignalKindText}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CoreNormalBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SignalLevel}" Value="{x:Static models:HealthLevel.Attention}">
                                                <Setter Property="Foreground" Value="{DynamicResource CoreAttentionBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SignalLevel}" Value="{x:Static models:HealthLevel.Warning}">
                                                <Setter Property="Foreground" Value="{DynamicResource CoreWarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SignalLevel}" Value="{x:Static models:HealthLevel.Critical}">
                                                <Setter Property="Foreground" Value="{DynamicResource CoreCriticalBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource PerformanceBadgeStyle}" Visibility="{Binding HasRisk, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="SemiBold" Opacity="0.78"/>
                        </Border>
                        <Border Style="{StaticResource PerformanceBadgeStyle}" Visibility="{Binding RequiresElevationWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="нужны права администратора" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CoreAttentionBrush}"/>
                        </Border>
                        <Border Style="{StaticResource PerformanceBadgeStyle}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="после применения нужна перезагрузка" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CoreAttentionBrush}"/>
                        </Border>
                        <Border Style="{StaticResource PerformanceBadgeStyle}" Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="недоступно" FontSize="11" FontWeight="SemiBold" Opacity="0.66"/>
                        </Border>
                        <Border Style="{StaticResource PerformanceBadgeStyle}" Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibilityConverter}}">
