<Page x:Class="TweakWise.Pages.MonitoringPerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      PreviewKeyDown="Page_PreviewKeyDown"
      Title="Производительность и охлаждение"
      Focusable="True"
      Background="{DynamicResource WindowBackground}">
    <Page.Resources>
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardPartHitStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardNodeGlowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="BoardPartShellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.25"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Opacity" Value="0.97"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.14" Color="#05080D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BoardSmallLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.76"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BoardTraceLineStyle" TargetType="Line">
            <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
            <Setter Property="StrokeThickness" Value="0.95"/>
            <Setter Property="Opacity" Value="0.18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardTracePolylineStyle" TargetType="Polyline">
            <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Opacity" Value="0.20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardOutlineStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="StrokeThickness" Value="1.15"/>
            <Setter Property="Opacity" Value="0.28"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style x:Key="DiagnosticCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#05080D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="BoardToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MaxWidth" Value="300"/>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource WindowBackground}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,18,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    Style="{StaticResource BackButtonStyle}"
                    ToolTip="Назад на главный экран"
                    Click="BackButton_Click"/>

            <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ModuleStatusIndicator"
                             Width="9"
                             Height="9"
                             Margin="0,1,10,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModuleStatusTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Opacity="0.78"/>
                </StackPanel>
                <TextBlock Text="Производительность и охлаждение"
                           Margin="0,8,0,0"
                           FontSize="25"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Grid.Column="3"
                       Text="Схема узлов питания, CPU, GPU, RAM и охлаждения"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Opacity="0.62"/>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,18">
            <Viewbox Stretch="Uniform"
                     MaxWidth="1340"
                     MaxHeight="790"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Canvas x:Name="BoardCanvas" Width="1220" Height="720">
                    <Border Canvas.Left="82"
                            Canvas.Top="50"
                            Width="1056"
                            Height="606"
                            Background="{DynamicResource ContentBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Opacity="0.98">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.16" Color="#05080D"/>
                        </Border.Effect>
                    </Border>

                    <Border Canvas.Left="128"
                            Canvas.Top="94"
                            Width="964"
                            Height="520"
                            Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Opacity="0.36"/>

                    <Canvas x:Name="MotherboardLayer" IsHitTestVisible="False">
                        <Rectangle Canvas.Left="154" Canvas.Top="116" Width="912" Height="474" RadiusX="14" RadiusY="14" Style="{StaticResource BoardOutlineStyle}" Opacity="0.28"/>
                        <Rectangle Canvas.Left="206" Canvas.Top="166" Width="808" Height="374" RadiusX="10" RadiusY="10" Style="{StaticResource BoardOutlineStyle}" Opacity="0.16"/>

                        <Line X1="610" Y1="116" X2="610" Y2="590" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.10"/>
                        <Line X1="154" Y1="340" X2="1066" Y2="340" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.10"/>
                        <Line X1="395" Y1="166" X2="395" Y2="604" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.07"/>
                        <Line X1="854" Y1="166" X2="854" Y2="604" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.07"/>

                        <Rectangle Canvas.Left="292" Canvas.Top="158" Width="206" Height="134" RadiusX="12" RadiusY="12" Style="{StaticResource BoardOutlineStyle}" Opacity="0.20"/>
                        <Rectangle Canvas.Left="512" Canvas.Top="242" Width="196" Height="196" RadiusX="16" RadiusY="16" Style="{StaticResource BoardOutlineStyle}" Opacity="0.22"/>
                        <Rectangle Canvas.Left="752" Canvas.Top="158" Width="204" Height="298" RadiusX="12" RadiusY="12" Style="{StaticResource BoardOutlineStyle}" Opacity="0.20"/>
                        <Rectangle Canvas.Left="292" Canvas.Top="492" Width="426" Height="120" RadiusX="12" RadiusY="12" Style="{StaticResource BoardOutlineStyle}" Opacity="0.20"/>
                        <Rectangle Canvas.Left="782" Canvas.Top="492" Width="246" Height="120" RadiusX="12" RadiusY="12" Style="{StaticResource BoardOutlineStyle}" Opacity="0.20"/>

                        <Polyline Points="490,226 506,226 506,300 520,300" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.28"/>
                        <Polyline Points="490,252 506,252 506,338 520,338" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.20"/>
                        <Polyline Points="700,306 736,306 736,304 760,304" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.28"/>
                        <Polyline Points="700,340 736,340 736,334 760,334" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.22"/>
                        <Polyline Points="610,430 610,476 505,476 505,500" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.28"/>
                        <Polyline Points="640,430 640,476 905,476 905,500" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.22"/>

                        <Rectangle Canvas.Left="184" Canvas.Top="206" Width="70" Height="246" RadiusX="8" RadiusY="8" Style="{StaticResource BoardOutlineStyle}" Opacity="0.16"/>
                        <Rectangle Canvas.Left="198" Canvas.Top="224" Width="42" Height="30" RadiusX="3" RadiusY="3" Style="{StaticResource BoardOutlineStyle}" Opacity="0.14"/>
                        <Rectangle Canvas.Left="198" Canvas.Top="270" Width="42" Height="30" RadiusX="3" RadiusY="3" Style="{StaticResource BoardOutlineStyle}" Opacity="0.14"/>
                        <Rectangle Canvas.Left="198" Canvas.Top="316" Width="42" Height="30" RadiusX="3" RadiusY="3" Style="{StaticResource BoardOutlineStyle}" Opacity="0.14"/>
                        <Rectangle Canvas.Left="198" Canvas.Top="362" Width="42" Height="30" RadiusX="3" RadiusY="3" Style="{StaticResource BoardOutlineStyle}" Opacity="0.14"/>
                        <Rectangle Canvas.Left="198" Canvas.Top="408" Width="42" Height="26" RadiusX="3" RadiusY="3" Style="{StaticResource BoardOutlineStyle}" Opacity="0.14"/>

                        <Rectangle Canvas.Left="588" Canvas.Top="144" Width="52" Height="18" RadiusX="2" RadiusY="2" Style="{StaticResource BoardOutlineStyle}" Opacity="0.16"/>
                        <Rectangle Canvas.Left="716" Canvas.Top="144" Width="62" Height="18" RadiusX="2" RadiusY="2" Style="{StaticResource BoardOutlineStyle}" Opacity="0.16"/>
                        <Rectangle Canvas.Left="978" Canvas.Top="224" Width="24" Height="112" RadiusX="3" RadiusY="3" Style="{StaticResource BoardOutlineStyle}" Opacity="0.14"/>
                        <Rectangle Canvas.Left="1010" Canvas.Top="224" Width="18" Height="112" RadiusX="3" RadiusY="3" Style="{StaticResource BoardOutlineStyle}" Opacity="0.12"/>

                        <Polyline Points="254,552 292,552 292,604" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.16"/>
                        <Polyline Points="1028,552 1066,552 1066,470" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.16"/>
                        <Ellipse Canvas.Left="558" Canvas.Top="452" Width="72" Height="72" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1" Opacity="0.12"/>
                        <Line X1="594" Y1="452" X2="594" Y2="524" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.10"/>
                        <Line X1="558" Y1="488" X2="630" Y2="488" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.10"/>
                    </Canvas>

                    <Canvas x:Name="RouteLayer" IsHitTestVisible="False">
                        <Canvas.Resources>
                            <Style x:Key="BoardRouteLineStyle" TargetType="Line">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter Property="StrokeThickness" Value="2.5"/>
                                <Setter Property="StrokeDashArray" Value="1,8"/>
                                <Setter Property="StrokeStartLineCap" Value="Round"/>
                                <Setter Property="StrokeEndLineCap" Value="Round"/>
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.42" Color="#4AA9FF"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Canvas.Resources>

                        <Line x:Name="PowerRouteLine" X1="610" Y1="340" X2="395" Y2="226" Style="{StaticResource BoardRouteLineStyle}"/>
                        <Line x:Name="GpuRouteLine" X1="610" Y1="340" X2="505" Y2="552" Style="{StaticResource BoardRouteLineStyle}"/>
                        <Line x:Name="RamRouteLine" X1="610" Y1="340" X2="854" Y2="326" Style="{StaticResource BoardRouteLineStyle}"/>
                        <Line x:Name="CoolingRouteLine" X1="610" Y1="340" X2="905" Y2="552" Style="{StaticResource BoardRouteLineStyle}"/>
                    </Canvas>

                    <Border x:Name="PowerGlow" Canvas.Left="300" Canvas.Top="166" Width="190" Height="118" Style="{StaticResource BoardNodeGlowStyle}"/>
                    <Border x:Name="CpuGlow" Canvas.Left="520" Canvas.Top="250" Width="180" Height="180" Style="{StaticResource BoardNodeGlowStyle}"/>
                    <Border x:Name="RamGlow" Canvas.Left="760" Canvas.Top="166" Width="188" Height="282" Style="{StaticResource BoardNodeGlowStyle}"/>
                    <Border x:Name="GpuGlow" Canvas.Left="300" Canvas.Top="500" Width="410" Height="104" Style="{StaticResource BoardNodeGlowStyle}"/>
                    <Border x:Name="CoolingGlow" Canvas.Left="790" Canvas.Top="500" Width="230" Height="104" Style="{StaticResource BoardNodeGlowStyle}"/>

                    <Border x:Name="PowerZone"
                            Tag="Power"
                            Canvas.Left="300"
                            Canvas.Top="166"
                            Width="190"
                            Height="118"
                            Style="{StaticResource BoardPartHitStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource BoardToolTipStyle}">
                                <StackPanel Width="260">
                                    <TextBlock Text="Питание" FontWeight="SemiBold"/>
                                    <TextBlock Text="Показывает, какой режим питания влияет на частоты, нагрев и работу от сети или батареи." Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.76"/>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <Canvas>
                            <Border Canvas.Left="0" Canvas.Top="0" Width="190" Height="118" Style="{StaticResource BoardPartShellStyle}"/>
                            <TextBlock Canvas.Left="18" Canvas.Top="16" Text="Питание" Style="{StaticResource BoardLabelStyle}"/>
                            <TextBlock Canvas.Left="18" Canvas.Top="44" Width="112" Text="режим питания" Style="{StaticResource BoardSmallLabelStyle}"/>
                            <Ellipse Canvas.Left="20" Canvas.Top="82" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                            <Ellipse Canvas.Left="42" Canvas.Top="82" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.26"/>
                            <Ellipse Canvas.Left="64" Canvas.Top="82" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                            <Rectangle x:Name="PowerPhaseA" Canvas.Left="112" Canvas.Top="42" Width="18" Height="52" RadiusX="2" RadiusY="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30"/>
                            <Rectangle x:Name="PowerPhaseB" Canvas.Left="140" Canvas.Top="32" Width="18" Height="72" RadiusX="2" RadiusY="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.42"/>
                            <Rectangle x:Name="PowerPhaseC" Canvas.Left="168" Canvas.Top="42" Width="18" Height="52" RadiusX="2" RadiusY="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30"/>
                        </Canvas>
                    </Border>

                    <Border x:Name="CpuZone"
                            Tag="Cpu"
                            Canvas.Left="520"
                            Canvas.Top="250"
                            Width="180"
                            Height="180"
                            Style="{StaticResource BoardPartHitStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource BoardToolTipStyle}">
                                <StackPanel Width="260">
                                    <TextBlock Text="Процессор" FontWeight="SemiBold"/>
                                    <TextBlock Text="Здесь собраны параметры, которые влияют на скорость CPU, автоматическое ускорение и нагрев под нагрузкой." Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.76"/>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <Canvas>
                            <Border Canvas.Left="0" Canvas.Top="0" Width="180" Height="180" Style="{StaticResource BoardPartShellStyle}" Opacity="0.92"/>
                            <Rectangle x:Name="CpuPackageGlow" Canvas.Left="16" Canvas.Top="16" Width="148" Height="148" RadiusX="14" RadiusY="14" Stroke="{DynamicResource CoreLineActiveBrush}" StrokeThickness="1.8" Fill="{DynamicResource ContentBackground}" Opacity="0.82"/>
                            <Rectangle Canvas.Left="42" Canvas.Top="42" Width="96" Height="96" RadiusX="10" RadiusY="10" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.2" Fill="{DynamicResource WindowBackground}" Opacity="0.98"/>
                            <UniformGrid x:Name="CpuActivityGrid" Canvas.Left="58" Canvas.Top="58" Width="64" Height="64" Columns="3" Rows="3" Opacity="0.72">
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.28"/>
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.38"/>
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.26"/>
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.34"/>
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.46"/>
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.30"/>
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.24"/>
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.33"/>
                                <Rectangle Fill="{DynamicResource CoreLineBrush}" Margin="3" Opacity="0.22"/>
                            </UniformGrid>
                            <TextBlock Canvas.Left="42" Canvas.Top="76" Width="96" Text="CPU" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Canvas.Left="36" Canvas.Top="110" Width="108" Text="частоты CPU" TextAlignment="Center" Style="{StaticResource BoardSmallLabelStyle}"/>
                        </Canvas>
                    </Border>

                    <Border x:Name="RamZone"
                            Tag="Ram"
                            Canvas.Left="760"
                            Canvas.Top="166"
                            Width="188"
                            Height="282"
                            Style="{StaticResource BoardPartHitStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource BoardToolTipStyle}">
                                <StackPanel Width="260">
                                    <TextBlock Text="Оперативная память" FontWeight="SemiBold"/>
                                    <TextBlock Text="Показывает загрузку ОЗУ и рекомендации, если памяти становится мало для производительных режимов." Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.76"/>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <Canvas>
                            <Border Canvas.Left="0" Canvas.Top="0" Width="188" Height="282" Style="{StaticResource BoardPartShellStyle}"/>
                            <TextBlock Canvas.Left="18" Canvas.Top="18" Text="RAM" Style="{StaticResource BoardLabelStyle}"/>
                            <TextBlock Canvas.Left="18" Canvas.Top="45" Width="134" Text="оперативная память" Style="{StaticResource BoardSmallLabelStyle}"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="82" Width="136" Height="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.28"/>
                            <Rectangle x:Name="RamSlotA" Canvas.Left="28" Canvas.Top="96" Width="18" Height="160" RadiusX="3" RadiusY="3" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1.4" Fill="{DynamicResource WindowBackground}" Opacity="0.76"/>
                            <Rectangle x:Name="RamSlotB" Canvas.Left="68" Canvas.Top="96" Width="18" Height="160" RadiusX="3" RadiusY="3" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1.4" Fill="{DynamicResource WindowBackground}" Opacity="0.66"/>
                            <Rectangle x:Name="RamSlotC" Canvas.Left="108" Canvas.Top="96" Width="18" Height="160" RadiusX="3" RadiusY="3" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1.4" Fill="{DynamicResource WindowBackground}" Opacity="0.76"/>
                            <Rectangle x:Name="RamSlotD" Canvas.Left="148" Canvas.Top="96" Width="18" Height="160" RadiusX="3" RadiusY="3" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1.4" Fill="{DynamicResource WindowBackground}" Opacity="0.66"/>
                        </Canvas>
                    </Border>

                    <Border x:Name="GpuZone"
                            Tag="Gpu"
                            Canvas.Left="300"
                            Canvas.Top="500"
                            Width="410"
                            Height="104"
                            Style="{StaticResource BoardPartHitStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource BoardToolTipStyle}">
                                <StackPanel Width="260">
                                    <TextBlock Text="Видеокарта" FontWeight="SemiBold"/>
                                    <TextBlock Text="Отвечает за графические параметры, состояние драйвера и температуру GPU во время нагрузки." Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.76"/>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <Canvas>
                            <Border Canvas.Left="0" Canvas.Top="0" Width="410" Height="104" Style="{StaticResource BoardPartShellStyle}"/>
                            <TextBlock Canvas.Left="20" Canvas.Top="18" Text="GPU" Style="{StaticResource BoardLabelStyle}"/>
                            <TextBlock Canvas.Left="20" Canvas.Top="45" Width="166" Text="видеокарта" Style="{StaticResource BoardSmallLabelStyle}"/>
                            <Rectangle Canvas.Left="190" Canvas.Top="48" Width="190" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.20"/>
                            <Rectangle Canvas.Left="178" Canvas.Top="42" Width="8" Height="24" RadiusX="2" RadiusY="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.34"/>
                            <Rectangle Canvas.Left="190" Canvas.Top="75" Width="190" Height="3" Fill="{DynamicResource CoreLineBrush}" Opacity="0.16"/>
                            <Rectangle x:Name="GpuSignalPulse" Canvas.Left="194" Canvas.Top="50" Width="42" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource CoreLineActiveBrush}" Opacity="0">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="GpuSignalTranslate" X="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                    </Border>

                    <Border x:Name="CoolingZone"
                            Tag="Cooling"
                            Canvas.Left="790"
                            Canvas.Top="500"
                            Width="230"
                            Height="104"
                            Style="{StaticResource BoardPartHitStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource BoardToolTipStyle}">
                                <StackPanel Width="260">
                                    <TextBlock Text="Охлаждение" FontWeight="SemiBold"/>
                                    <TextBlock Text="Здесь видны температуры и рекомендации по вентиляторам, если системе не хватает охлаждения." Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.76"/>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <Canvas>
                            <Border Canvas.Left="0" Canvas.Top="0" Width="230" Height="104" Style="{StaticResource BoardPartShellStyle}"/>
                            <TextBlock Canvas.Left="20" Canvas.Top="18" Text="Охлаждение" Style="{StaticResource BoardLabelStyle}"/>
                            <TextBlock Canvas.Left="20" Canvas.Top="47" Width="112" Text="температуры" Style="{StaticResource BoardSmallLabelStyle}"/>
                            <Ellipse Canvas.Left="24" Canvas.Top="78" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30"/>
                            <Ellipse Canvas.Left="46" Canvas.Top="78" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.24"/>
                            <Ellipse Canvas.Left="68" Canvas.Top="78" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30"/>
                            <Canvas x:Name="CoolingFanRotor" Canvas.Left="142" Canvas.Top="15" Width="74" Height="74" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="CoolingFanRotate" Angle="0"/>
                                </Canvas.RenderTransform>
                                <Ellipse Width="74" Height="74" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="2" Opacity="0.54"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.34" Data="M37,7 C52,9 58,22 48,32 C44,36 39,36 35,32 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.28" Data="M67,37 C65,52 52,58 42,48 C39,44 39,39 43,35 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.34" Data="M37,67 C22,65 16,52 26,42 C30,39 35,39 39,43 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.28" Data="M7,37 C9,22 22,16 32,26 C36,30 36,35 32,39 Z"/>
                            </Canvas>
                            <Ellipse Canvas.Left="170" Canvas.Top="43" Width="18" Height="18" Fill="{DynamicResource CoreLineBrush}" Opacity="0.48"/>
                        </Canvas>
                    </Border>

                    <Canvas x:Name="CalloutLayer" IsHitTestVisible="False"/>
                </Canvas>
            </Viewbox>
        </Grid>

        <Grid x:Name="NodeDetailsLayer" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0">
            <Border Background="{DynamicResource WindowBackground}" Opacity="0.80" MouseLeftButtonDown="DetailsScrim_MouseLeftButtonDown"/>

            <Border x:Name="NodeDetailsPanel"
                    Width="408"
                    Margin="0,78,28,28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource CoreNodeBackgroundBrush}"
                    BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NodeDetailsTranslate" X="44"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Выбранный узел" FontSize="12" FontWeight="SemiBold" Opacity="0.62"/>
                        <TextBlock x:Name="SelectedTitleTextBlock" Margin="0,7,0,0" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedDescriptionTextBlock" Margin="0,9,0,0" FontSize="13" LineHeight="19" Opacity="0.78" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedFindingSummaryTextBlock" Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Проблемы и рекомендации" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedFindingsEmptyText" Text="По этому узлу сейчас нет активных проблем или рекомендаций." Margin="0,8,0,0" FontSize="12" Opacity="0.70" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="SelectedFindingsItemsControl" Margin="0,10,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DetailsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" Margin="0,7,0,0" FontSize="12" LineHeight="18" Opacity="0.78" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Параметры" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold"/>
                            <ItemsControl x:Name="ActionItemsControl" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DetailsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource CoreNodeBackgroundBrush}" BorderBrush="{DynamicResource CoreNodeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Channel}" FontSize="11" FontWeight="SemiBold" Opacity="0.74"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" Margin="0,7,0,0" FontSize="12" LineHeight="18" Opacity="0.78" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
