                            <TextBlock Text="Текущее состояние" FontSize="11" FontWeight="SemiBold" Opacity="0.62"/>
                            <TextBlock Text="{Binding CurrentValue}" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Recommendation}"
                               Margin="0,10,0,0"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Opacity="0.78"
                               Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibilityConverter}}"/>

