                                Tag="Off"
                                Style="{StaticResource PerformanceActionButtonStyle}"
                                Click="ApplyPowerSliderShortcut_Click"
                                IsEnabled="{Binding CanApply}"/>
                        <Button Content="{Binding QuickEnableText}"
                                Tag="On"
                                Style="{StaticResource PerformanceActionButtonStyle}"
                                Click="ApplyPowerSliderShortcut_Click"
                                IsEnabled="{Binding CanApply}"/>
                        <TextBlock Text="0 минут = отключено/никогда"
                                   Margin="2,6,0,8"
                                   Foreground="{DynamicResource WindowForeground}"
                                   Opacity="0.62"
                                   FontSize="12"/>
                    </WrapPanel>

                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            Background="{DynamicResource CoreNodeBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Opacity="0.84"/>
                    </Border>

                    <WrapPanel Margin="0,14,0,-8">
                        <Button Content="{Binding ApplyButtonText}"
                                Style="{StaticResource PerformancePrimaryActionButtonStyle}"
                                IsEnabled="{Binding CanApply}"
                                Visibility="{Binding ShowApplyAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="ApplyPerformanceSetting_Click"/>
                        <Button Content="Откатить"
                                Style="{StaticResource PerformanceActionButtonStyle}"
                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="RollbackPerformanceSetting_Click"/>
                        <Button Content="Удалить бэкап"
                                Style="{StaticResource PerformanceActionButtonStyle}"
                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibilityConverter}}"
