                                Margin="10,0,0,0"
                                Height="30"
                                Background="{DynamicResource ContentBackground}"
                                BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <TextBlock Text="{Binding NumericValueText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasSliderShortcuts, Converter={StaticResource BoolToVisibilityConverter}}">
