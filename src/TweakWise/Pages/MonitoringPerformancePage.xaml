<Page x:Class="TweakWise.Pages.MonitoringPerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      PreviewKeyDown="Page_PreviewKeyDown"
      Title="Производительность и охлаждение"
      Focusable="True"
      Background="{DynamicResource WindowBackground}">
    <Page.Resources>
        <Style x:Key="BoardNodeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardNodeGlowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="BoardTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
        </Style>

        <Style x:Key="BoardSubTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
        </Style>

        <Style x:Key="DiagnosticCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="DetailsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootLayer"
          Background="{DynamicResource WindowBackground}"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="28,20,28,0"
              IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ModuleStatusIndicator"
                             Width="9"
                             Height="9"
                             Margin="0,1,10,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModuleStatusTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Opacity="0.78"/>
                </StackPanel>
                <TextBlock Text="Производительность и охлаждение"
                           Margin="0,8,0,0"
                           FontSize="25"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Text="Карта узлов питания, CPU, GPU, RAM и охлаждения"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,28,0,0"
                       FontSize="13"
                       Opacity="0.62"/>
        </Grid>

        <Grid Grid.Row="1"
              Margin="24,0,24,18">
            <Viewbox Stretch="Uniform"
                     MaxWidth="1260"
                     MaxHeight="760"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Canvas x:Name="BoardCanvas"
                        Width="1180"
                        Height="720">
                    <Border Canvas.Left="56"
                            Canvas.Top="38"
                            Width="1068"
                            Height="620"
                            Background="{DynamicResource ContentBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="26"
                            Opacity="0.96"/>

                    <Canvas x:Name="CircuitTextureLayer"
                            IsHitTestVisible="False"
                            Opacity="0.72">
                        <Canvas.Resources>
                            <Style TargetType="Line">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                                <Setter Property="Opacity" Value="0.22"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                            <Style TargetType="Polyline">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
                                <Setter Property="StrokeThickness" Value="1.1"/>
                                <Setter Property="Opacity" Value="0.28"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
                                <Setter Property="StrokeThickness" Value="1"/>
                                <Setter Property="Opacity" Value="0.18"/>
                            </Style>
                        </Canvas.Resources>

                        <Ellipse Canvas.Left="392" Canvas.Top="150" Width="396" Height="396" StrokeDashArray="12,10" Opacity="0.23"/>
                        <Ellipse Canvas.Left="450" Canvas.Top="208" Width="280" Height="280" Opacity="0.18"/>
                        <Rectangle Canvas.Left="104" Canvas.Top="90" Width="972" Height="506" RadiusX="18" RadiusY="18" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1" Opacity="0.18"/>
                        <Rectangle Canvas.Left="160" Canvas.Top="142" Width="860" Height="402" RadiusX="14" RadiusY="14" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1" Opacity="0.14"/>

                        <Line X1="590" Y1="62" X2="590" Y2="640" Opacity="0.12"/>
                        <Line X1="112" Y1="348" X2="1068" Y2="348" Opacity="0.12"/>
                        <Line X1="288" Y1="92" X2="288" Y2="596" Opacity="0.10"/>
                        <Line X1="890" Y1="92" X2="890" Y2="596" Opacity="0.10"/>

                        <Polyline Points="224,168 388,168 388,270 498,270"/>
                        <Polyline Points="948,168 792,168 792,270 682,270"/>
                        <Polyline Points="260,514 402,514 402,418 498,418"/>
                        <Polyline Points="920,510 776,510 776,420 682,420"/>
                        <Polyline Points="590,178 590,252"/>
                        <Polyline Points="590,442 590,588"/>
                        <Polyline Points="174,286 320,286 320,330 498,330"/>
                        <Polyline Points="1006,286 860,286 860,330 682,330"/>

                        <Ellipse Canvas.Left="220" Canvas.Top="164" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" StrokeThickness="0" Opacity="0.32"/>
                        <Ellipse Canvas.Left="944" Canvas.Top="164" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" StrokeThickness="0" Opacity="0.32"/>
                        <Ellipse Canvas.Left="256" Canvas.Top="510" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" StrokeThickness="0" Opacity="0.32"/>
                        <Ellipse Canvas.Left="916" Canvas.Top="506" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" StrokeThickness="0" Opacity="0.32"/>
                    </Canvas>

                    <Canvas x:Name="RouteLayer"
                            IsHitTestVisible="False">
                        <Canvas.Resources>
                            <Style x:Key="BoardRouteLineStyle" TargetType="Line">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter Property="StrokeThickness" Value="2.6"/>
                                <Setter Property="StrokeDashArray" Value="1,8"/>
                                <Setter Property="StrokeStartLineCap" Value="Round"/>
                                <Setter Property="StrokeEndLineCap" Value="Round"/>
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.42" Color="#4AA9FF"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Canvas.Resources>

                        <Line x:Name="PowerRouteLine" X1="590" Y1="348" X2="258" Y2="184" Style="{StaticResource BoardRouteLineStyle}"/>
                        <Line x:Name="GpuRouteLine" X1="590" Y1="348" X2="314" Y2="510" Style="{StaticResource BoardRouteLineStyle}"/>
                        <Line x:Name="RamRouteLine" X1="590" Y1="348" X2="844" Y2="172" Style="{StaticResource BoardRouteLineStyle}"/>
                        <Line x:Name="CoolingRouteLine" X1="590" Y1="348" X2="885" Y2="444" Style="{StaticResource BoardRouteLineStyle}"/>
                    </Canvas>

                    <Border x:Name="CpuGlow" Canvas.Left="468" Canvas.Top="230" Width="244" Height="226" Style="{StaticResource BoardNodeGlowStyle}"/>
                    <Border x:Name="PowerGlow" Canvas.Left="134" Canvas.Top="104" Width="298" Height="164" Style="{StaticResource BoardNodeGlowStyle}"/>
                    <Border x:Name="RamGlow" Canvas.Left="752" Canvas.Top="102" Width="308" Height="156" Style="{StaticResource BoardNodeGlowStyle}"/>
                    <Border x:Name="GpuGlow" Canvas.Left="132" Canvas.Top="426" Width="370" Height="132" Style="{StaticResource BoardNodeGlowStyle}"/>
                    <Border x:Name="CoolingGlow" Canvas.Left="732" Canvas.Top="382" Width="332" Height="178" Style="{StaticResource BoardNodeGlowStyle}"/>

                    <Border x:Name="CpuZone"
                            Tag="Cpu"
                            Canvas.Left="492"
                            Canvas.Top="252"
                            Width="196"
                            Height="182"
                            Style="{StaticResource BoardNodeStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Grid>
                            <Border Background="{DynamicResource CoreOrbShadowBrush}"
                                    BorderBrush="{DynamicResource CoreLineActiveBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="13"
                                    Opacity="0.46"/>
                            <Grid Margin="28">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Row="0" Grid.Column="0" Fill="{DynamicResource CoreLineBrush}" Opacity="0.20" Margin="2"/>
                                <Rectangle Grid.Row="0" Grid.Column="1" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30" Margin="2"/>
                                <Rectangle Grid.Row="0" Grid.Column="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.18" Margin="2"/>
                                <Rectangle Grid.Row="0" Grid.Column="3" Fill="{DynamicResource CoreLineBrush}" Opacity="0.26" Margin="2"/>
                                <Rectangle Grid.Row="1" Grid.Column="0" Fill="{DynamicResource CoreLineBrush}" Opacity="0.28" Margin="2"/>
                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="{DynamicResource CoreLineBrush}" Opacity="0.20" Margin="2"/>
                                <Rectangle Grid.Row="1" Grid.Column="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32" Margin="2"/>
                                <Rectangle Grid.Row="1" Grid.Column="3" Fill="{DynamicResource CoreLineBrush}" Opacity="0.22" Margin="2"/>
                                <Rectangle Grid.Row="2" Grid.Column="0" Fill="{DynamicResource CoreLineBrush}" Opacity="0.17" Margin="2"/>
                                <Rectangle Grid.Row="2" Grid.Column="1" Fill="{DynamicResource CoreLineBrush}" Opacity="0.26" Margin="2"/>
                                <Rectangle Grid.Row="2" Grid.Column="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.19" Margin="2"/>
                                <Rectangle Grid.Row="2" Grid.Column="3" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30" Margin="2"/>
                                <Rectangle Grid.Row="3" Grid.Column="0" Fill="{DynamicResource CoreLineBrush}" Opacity="0.24" Margin="2"/>
                                <Rectangle Grid.Row="3" Grid.Column="1" Fill="{DynamicResource CoreLineBrush}" Opacity="0.18" Margin="2"/>
                                <Rectangle Grid.Row="3" Grid.Column="2" Fill="{DynamicResource CoreLineBrush}" Opacity="0.28" Margin="2"/>
                                <Rectangle Grid.Row="3" Grid.Column="3" Fill="{DynamicResource CoreLineBrush}" Opacity="0.21" Margin="2"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="CPU"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="планировщик, boost"
                                           Margin="0,6,0,0"
                                           FontSize="11"
                                           Opacity="0.74"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="PowerZone"
                            Tag="Power"
                            Canvas.Left="152"
                            Canvas.Top="122"
                            Width="262"
                            Height="128"
                            Style="{StaticResource BoardNodeStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Питание и лимиты" Style="{StaticResource BoardTitleTextStyle}"/>
                            <TextBlock Grid.Row="1" Text="power plan, throttling, VRM" Style="{StaticResource BoardSubTextStyle}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Rectangle Width="18" Height="42" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30" Margin="0,0,7,0"/>
                                <Rectangle Width="18" Height="56" Fill="{DynamicResource CoreLineBrush}" Opacity="0.42" Margin="0,0,7,0"/>
                                <Rectangle Width="18" Height="34" Fill="{DynamicResource CoreLineBrush}" Opacity="0.26"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="RamZone"
                            Tag="Ram"
                            Canvas.Left="772"
                            Canvas.Top="120"
                            Width="268"
                            Height="120"
                            Style="{StaticResource BoardNodeStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="RAM" Style="{StaticResource BoardTitleTextStyle}"/>
                            <TextBlock Grid.Row="1" Text="каналы, объём, стабильность" Style="{StaticResource BoardSubTextStyle}"/>
                            <Grid Grid.Row="1" Margin="122,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource CoreOrbShadowBrush}" BorderBrush="{DynamicResource CoreLineBrush}" BorderThickness="1" CornerRadius="5" Opacity="0.64"/>
                                <Border Grid.Row="2" Background="{DynamicResource CoreOrbShadowBrush}" BorderBrush="{DynamicResource CoreLineBrush}" BorderThickness="1" CornerRadius="5" Opacity="0.52"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="GpuZone"
                            Tag="Gpu"
                            Canvas.Left="152"
                            Canvas.Top="444"
                            Width="332"
                            Height="96"
                            Style="{StaticResource BoardNodeStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GPU" Style="{StaticResource BoardTitleTextStyle}"/>
                                <TextBlock Text="драйвер, графический стек, температура" Style="{StaticResource BoardSubTextStyle}"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Width="74" Height="48" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="2" Opacity="0.38"/>
                                <Line X1="37" Y1="5" X2="37" Y2="43" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1.6" Opacity="0.36"/>
                                <Line X1="10" Y1="24" X2="64" Y2="24" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="1.6" Opacity="0.36"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="CoolingZone"
                            Tag="Cooling"
                            Canvas.Left="752"
                            Canvas.Top="402"
                            Width="292"
                            Height="138"
                            Style="{StaticResource BoardNodeStyle}"
                            MouseEnter="Component_MouseEnter"
                            MouseLeave="Component_MouseLeave"
                            MouseLeftButtonUp="Component_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Охлаждение" Style="{StaticResource BoardTitleTextStyle}"/>
                                <TextBlock Text="датчики, вентиляторы, термоконтур" Style="{StaticResource BoardSubTextStyle}"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Width="76" Height="76" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="2" Opacity="0.42"/>
                                <Ellipse Width="18" Height="18" Fill="{DynamicResource CoreLineBrush}" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.34" Data="M38,10 C52,12 57,23 48,32 C44,35 39,36 36,32 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.28" Data="M66,38 C64,52 53,57 44,48 C41,44 40,39 44,36 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.34" Data="M38,66 C24,64 19,53 28,44 C32,41 37,40 40,44 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.28" Data="M10,38 C12,24 23,19 32,28 C35,32 36,37 32,40 Z"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Canvas x:Name="CalloutLayer"
                            IsHitTestVisible="False"/>
                </Canvas>
            </Viewbox>
        </Grid>

        <Grid x:Name="NodeDetailsLayer"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Opacity="0">
            <Border x:Name="DetailsScrim"
                    Background="{DynamicResource WindowBackground}"
                    Opacity="0.80"
                    MouseLeftButtonDown="DetailsScrim_MouseLeftButtonDown"/>

            <Border x:Name="NodeDetailsPanel"
                    Width="408"
                    Margin="0,78,28,28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource CoreNodeBackgroundBrush}"
                    BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NodeDetailsTranslate" X="44"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Выбранный узел"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.62"/>
                        <TextBlock x:Name="SelectedTitleTextBlock"
                                   Margin="0,7,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedDescriptionTextBlock"
                                   Margin="0,9,0,0"
                                   FontSize="13"
                                   LineHeight="19"
                                   Opacity="0.78"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedFindingSummaryTextBlock"
                                   Margin="0,14,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Проблемы и рекомендации"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedFindingsEmptyText"
                                       Text="По этому узлу сейчас нет активных проблем или рекомендаций."
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Opacity="0.70"
                                       TextWrapping="Wrap"/>
                            <ItemsControl x:Name="SelectedFindingsItemsControl"
                                          Margin="0,10,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DetailsCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,7,0,0"
                                                           FontSize="12"
                                                           LineHeight="18"
                                                           Opacity="0.78"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Параметры"
                                       Margin="0,8,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            <ItemsControl x:Name="ActionItemsControl"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DetailsCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1"
                                                            Background="{DynamicResource ContentBackground}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="7,2"
                                                            Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Channel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Opacity="0.74"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,7,0,0"
                                                           FontSize="12"
                                                           LineHeight="18"
                                                           Opacity="0.78"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
