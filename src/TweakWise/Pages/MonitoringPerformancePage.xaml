                            <TextBlock Canvas.Left="20" Canvas.Top="47" Width="112" Text="температуры" Style="{StaticResource BoardSmallLabelStyle}"/>
                            <Ellipse Canvas.Left="24" Canvas.Top="78" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30"/>
                            <Ellipse Canvas.Left="46" Canvas.Top="78" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.24"/>
                            <Ellipse Canvas.Left="68" Canvas.Top="78" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.30"/>
                            <Canvas x:Name="CoolingFanRotor" Canvas.Left="142" Canvas.Top="15" Width="74" Height="74" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="CoolingFanRotate" Angle="0"/>
                                </Canvas.RenderTransform>
                                <Ellipse Width="74" Height="74" Stroke="{DynamicResource CoreLineBrush}" StrokeThickness="2" Opacity="0.54"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.34" Data="M37,7 C52,9 58,22 48,32 C44,36 39,36 35,32 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.28" Data="M67,37 C65,52 52,58 42,48 C39,44 39,39 43,35 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.34" Data="M37,67 C22,65 16,52 26,42 C30,39 35,39 39,43 Z"/>
                                <Path Fill="{DynamicResource CoreLineBrush}" Opacity="0.28" Data="M7,37 C9,22 22,16 32,26 C36,30 36,35 32,39 Z"/>
                            </Canvas>
                            <Ellipse Canvas.Left="170" Canvas.Top="43" Width="18" Height="18" Fill="{DynamicResource CoreLineBrush}" Opacity="0.48"/>
                        </Canvas>
                    </Border>

                    <Canvas x:Name="CalloutLayer" IsHitTestVisible="True"/>
                </Canvas>
            </Viewbox>
        </Grid>

        <Grid x:Name="NodeDetailsLayer" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0">
            <Border x:Name="DetailsScrim"
                    Background="{DynamicResource WindowBackground}"
                    Opacity="0.80"
                    MouseLeftButtonDown="DetailsScrim_MouseLeftButtonDown"/>

            <Border x:Name="NodeDetailsPanel"
                    MaxWidth="1120"
                    Margin="28,78,28,28"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource CoreNodeBackgroundBrush}"
                    BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="NodeDetailsScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="NodeDetailsTranslate" X="44"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Выбранный узел" FontSize="12" FontWeight="SemiBold" Opacity="0.62"/>
                        <TextBlock x:Name="SelectedTitleTextBlock" Margin="0,7,0,0" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedDescriptionTextBlock" Margin="0,9,0,0" FontSize="13" LineHeight="19" Opacity="0.78" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedFindingSummaryTextBlock" Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer x:Name="NodeDetailsScrollViewer" Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Проблемы и рекомендации" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedFindingsEmptyText" Text="По этому узлу сейчас нет активных проблем или рекомендаций." Margin="0,8,0,0" FontSize="12" Opacity="0.70" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="SelectedFindingsItemsControl" Margin="0,10,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DetailsCardStyle}"
                                                Loaded="SelectedFindingCard_Loaded"
                                                Cursor="Hand"
                                                ToolTip="Перейти к связанному блоку"
                                                MouseLeftButtonUp="SelectedFindingCard_MouseLeftButtonUp">
                                            <StackPanel>
                                                <TextBlock Text="{Binding KindText}" FontSize="11" FontWeight="SemiBold" Opacity="0.78"/>
                                                <TextBlock Text="{Binding Title}" Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" Margin="0,7,0,0" FontSize="12" LineHeight="18" Opacity="0.78" TextWrapping="Wrap"/>
                                                <Button Content="Игнорировать"
                                                        Tag="{Binding Id}"
                                                        Margin="0,10,0,0"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource PerformanceActionButtonStyle}"
                                                        Click="IgnoreBoardFinding_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Параметры и действия" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold"/>
                            <Grid Margin="0,10,0,0">
                                <TextBox x:Name="PerformanceSearchTextBox"
                                         Style="{StaticResource PerformanceSearchBoxStyle}"
                                         GotKeyboardFocus="PerformanceSearchTextBox_GotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="PerformanceSearchTextBox_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="PerformanceSearchTextBox_PreviewMouseLeftButtonUp"
                                         KeyDown="PerformanceSearchTextBox_KeyDown"
                                         TextChanged="PerformanceSearchTextBox_TextChanged"/>
                                <TextBlock x:Name="PerformanceSearchPlaceholderTextBlock"
                                           Text="Поиск по разделам и параметрам этого узла"
                                           Margin="42,0,36,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           IsHitTestVisible="False"
                                           Opacity="0.45"/>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Opacity="0.58"/>
                                <Button x:Name="PerformanceSearchClearButton"
                                        Content="&#xE711;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PerformanceActionButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="PerformanceSearchClearButton_Click"/>
                            </Grid>
                            <ItemsControl x:Name="PerformanceSearchSuggestionsItemsControl"
                                          Margin="0,8,0,0"
                                          MaxHeight="92"
                                          Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PerformanceActionButtonStyle}"
                                                Click="PerformanceSearchSuggestion_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Caption}" Margin="0,2,0,0" FontSize="10" Opacity="0.58" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,8,0,0">
                                <ToggleButton x:Name="PerformanceFilterAllButton"
                                              Content="Все"
                                              Tag="All"
                                              IsChecked="True"
                                              Style="{StaticResource PerformanceFilterToggleStyle}"
                                              Click="PerformanceSignalFilter_Click"/>
                                <ToggleButton x:Name="PerformanceFilterRecommendationsButton"
                                              Content="Рекомендации"
                                              Tag="Recommendations"
                                              Style="{StaticResource PerformanceFilterToggleStyle}"
                                              Click="PerformanceSignalFilter_Click"/>
                                <ToggleButton x:Name="PerformanceFilterProblemsButton"
                                              Content="Проблемы"
                                              Tag="Problems"
                                              Style="{StaticResource PerformanceFilterToggleStyle}"
                                              Click="PerformanceSignalFilter_Click"/>
                                <ToggleButton x:Name="PerformanceFilterCriticalButton"
                                              Content="Критические"
                                              Tag="Critical"
                                              Style="{StaticResource PerformanceFilterToggleStyle}"
                                              Click="PerformanceSignalFilter_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="PerformanceSearchEmptyText"
                                       Text="По этому запросу в текущем узле ничего не найдено."
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Opacity="0.70"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="PerformanceSettingsEmptyText"
                                       Text="Для этого узла пока нет доступных действий."
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Opacity="0.70"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                            <Border x:Name="PerformanceSettingsLoadingPanel"
                                    Margin="0,12,0,0"
                                    Padding="18,20"
                                    Background="{DynamicResource ContentBackground}"
                                    BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <UniformGrid Rows="2" Columns="2" Width="60" Height="60" HorizontalAlignment="Center">
                                        <Border x:Name="LoadingSquareA" Style="{StaticResource PerformanceLoadingSquareStyle}"/>
                                        <Border x:Name="LoadingSquareB" Style="{StaticResource PerformanceLoadingSquareStyle}"/>
                                        <Border x:Name="LoadingSquareC" Style="{StaticResource PerformanceLoadingSquareStyle}"/>
                                        <Border x:Name="LoadingSquareD" Style="{StaticResource PerformanceLoadingSquareStyle}"/>
                                    </UniformGrid>
                                    <TextBlock Text="Загрузка узла, пожалуйста подождите"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Opacity="0.76"/>
                                     <TextBlock Text="Считываем параметры системы и подготавливаем доступные действия."
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Opacity="0.56"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="PerformanceSettingsItemsControl" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Loaded="PerformanceSection_Loaded"
                                                Margin="0,0,0,10"
                                                Padding="0"
                                                CornerRadius="12"
                                                Background="Transparent">
                                            <Grid>
                                                <Border Tag="SearchHighlightOverlay"
                                                        Margin="-8"
                                                        CornerRadius="12"
                                                        Background="{StaticResource SearchHighlightGradientBrush}"
                                                        BorderBrush="{DynamicResource CoreLineActiveBrush}"
                                                        BorderThickness="1"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"/>
                                                <StackPanel>
                                                    <Border Padding="0,0,0,8"
                                                            BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12" LineHeight="18" Opacity="0.68" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Items}"
                                                                  ItemTemplate="{StaticResource PerformanceSettingItemTemplate}"
                                                                  Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="PerformanceNavigationBusyOverlay"
                            Grid.RowSpan="2"
                            Panel.ZIndex="20"
                            Background="#D91D2A34"
                            BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed"
                            Opacity="0"
                            IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UniformGrid Rows="2" Columns="2" Width="60" Height="60" HorizontalAlignment="Center">
                                <Border x:Name="SearchBusySquareA" Style="{StaticResource PerformanceLoadingSquareStyle}"/>
                                <Border x:Name="SearchBusySquareB" Style="{StaticResource PerformanceLoadingSquareStyle}"/>
                                <Border x:Name="SearchBusySquareC" Style="{StaticResource PerformanceLoadingSquareStyle}"/>
                                <Border x:Name="SearchBusySquareD" Style="{StaticResource PerformanceLoadingSquareStyle}"/>
                            </UniformGrid>
                            <TextBlock Text="Загрузка перехода, пожалуйста подождите"
                                       Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.80"/>
                            <TextBlock Text="Открываем нужный блок и подготавливаем подсветку."
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Opacity="0.58"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="NodeDetailsOrbButton"
                    Style="{StaticResource EnergyOrbButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0"
                    ToolTip="Свернуть узел и вернуться к карте"
                    Visibility="Collapsed"
                    Opacity="0"
                    Click="NodeDetailsOrbButton_Click"
                    RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="NodeDetailsOrbScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="NodeDetailsOrbTranslate"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
        </Grid>
    </Grid>
</Page>
