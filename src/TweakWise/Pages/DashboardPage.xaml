<Page x:Class="TweakWise.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная"
      Background="{DynamicResource ContentBackground}">
    <ScrollViewer Padding="20"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CatalogSectionBorderStyle}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Главная"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Здесь будет быстрый запуск основных действий."
                               Margin="0,10,0,0"
                               Opacity="0.84"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="DashboardBlocksItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CatalogSectionBorderStyle}"
                                Width="280"
                                Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Раздел готов к наполнению."
                                           Margin="0,8,0,0"
                                           Opacity="0.82"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
