                                            <primitives:ToggleButton x:Name="MaximumCleanupProfileButton" Content="Максимум" Tag="&#xE74D;" Style="{StaticResource CleanupProfileToggleStyle}" Click="CleanupProfileToggleButton_Click"/>
                                            <primitives:ToggleButton x:Name="DisableCleanupProfileButton" Content="Выкл." Tag="&#xE711;" Style="{StaticResource CleanupProfileToggleStyle}" Click="CleanupProfileToggleButton_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="CleanupSummaryTextBlock" Margin="0,6,0,0" FontSize="12" LineHeight="17" TextWrapping="Wrap" Opacity="0.82" Foreground="{DynamicResource WindowForeground}"/>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" MinHeight="92" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="CleanupTargetsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,10">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Style="{StaticResource SwitchCheckBoxStyle}"
                                                                  Checked="CleanupTargetCheckBox_Changed"
                                                                  Unchecked="CleanupTargetCheckBox_Changed">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}"/>
                                                                <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="11" LineHeight="16" TextWrapping="Wrap" Opacity="0.66" Foreground="{DynamicResource WindowForeground}"/>
                                                                <TextBlock Text="{Binding EstimateText}" Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" Opacity="0.84" Foreground="{DynamicResource WindowForeground}"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border Grid.Row="2" Margin="0,10,0,0" Background="Transparent">
                                        <Grid>
