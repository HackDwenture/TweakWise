                                <TranslateTransform x:Name="CleanupCardTranslate"/>
                            </Button.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="13" Background="#1D4EA8FF" BorderBrush="{DynamicResource CoreLineActiveBrush}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WindowForeground}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Очистка" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}"/>
