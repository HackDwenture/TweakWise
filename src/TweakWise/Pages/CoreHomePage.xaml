                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border x:Name="CoreDetailWorkbench" Canvas.Left="762" Canvas.Top="144" Width="324" Height="436" Style="{StaticResource GlassCardStyle}" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="WorkbenchCardTranslate"/>
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel x:Name="CoreMonitorPanel">
                                    <TextBlock Text="Быстрый мониторинг" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}"/>
