                                                    <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Запустить очистку"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AnalyzeCleanupButton"
                                                    Grid.Column="1"
                                                    MinHeight="38"
                                                    Margin="10,0,0,0"
