                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               LineHeight="17"
                                               TextWrapping="Wrap"
                                               Opacity="0.76"
                                               Foreground="{DynamicResource WindowForeground}"/>
                                    <ScrollViewer Margin="0,14,0,0" MaxHeight="328" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="SystemStatsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,9" Padding="10,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="78"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource MetricIconBadgeStyle}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource WindowForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}"/>
                                                                <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="10.5" LineHeight="14" TextWrapping="Wrap" Opacity="0.66" Foreground="{DynamicResource WindowForeground}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" TextAlignment="Right" Foreground="{DynamicResource WindowForeground}"/>
                                                                <ProgressBar Value="{Binding Percent}" Maximum="100" Height="5" Margin="0,8,0,0" Foreground="{DynamicResource CoreLineActiveBrush}" Background="{DynamicResource CardBackground}" BorderThickness="0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <StackPanel x:Name="CoreDiagnosticsPanel" Visibility="Collapsed">
                                    <TextBlock Text="Быстрая диагностика" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}"/>
