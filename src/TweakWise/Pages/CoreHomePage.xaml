                                                    Click="AnalyzeCleanupButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Оценить"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="CleanupBusyOverlay" Canvas.Left="762" Canvas.Top="144" Width="324" Height="436" Background="#EB1D2A34" BorderBrush="{DynamicResource CoreNodeBorderBrush}" BorderThickness="1" CornerRadius="18" Visibility="Collapsed" Opacity="0">
