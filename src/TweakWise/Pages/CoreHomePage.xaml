                        <Ellipse Canvas.Left="350" Canvas.Top="118" Width="400" Height="400" Stroke="{DynamicResource CoreLineActiveBrush}" StrokeThickness="1" StrokeDashArray="11,9" Opacity="0.32"/>
                        <Ellipse Canvas.Left="402" Canvas.Top="170" Width="296" Height="296" Stroke="{DynamicResource CoreLineActiveBrush}" StrokeThickness="1" Opacity="0.45"/>

                        <controls:SystemCoreControl x:Name="ExpandedCore"
                                                     Canvas.Left="410"
                                                     Canvas.Top="176"
                                                     Width="280"
                                                     Height="280"
