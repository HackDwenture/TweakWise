                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="DetailsCleanupCard" Canvas.Left="18" Canvas.Top="376" Width="300" Height="116" Style="{StaticResource CoreDetailTabButtonStyle}" Tag="Cleanup" Click="CoreDetailTabButton_Click" Opacity="0">
