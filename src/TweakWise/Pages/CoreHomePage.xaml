                                                            <Border Width="30" Height="30" CornerRadius="10" Background="#1B4EA8FF" BorderBrush="{DynamicResource CoreLineActiveBrush}" BorderThickness="1" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource WindowForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}"/>
                                                                <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="11" LineHeight="16" TextWrapping="Wrap" Opacity="0.66" Foreground="{DynamicResource WindowForeground}"/>
                                                                <ProgressBar Value="{Binding Percent}" Maximum="100" Height="5" Margin="0,9,0,0" Foreground="{DynamicResource CoreLineActiveBrush}" Background="{DynamicResource CardBackground}" BorderThickness="0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource WindowForeground}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <Grid x:Name="CoreCleanupPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
