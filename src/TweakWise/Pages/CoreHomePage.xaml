                                <TranslateTransform x:Name="DiagnosticsCardTranslate"/>
                            </Button.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="13" Background="#1D4EA8FF" BorderBrush="{DynamicResource CoreLineActiveBrush}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WindowForeground}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Быстрая диагностика" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}"/>
                                    <TextBlock Text="Сводка по узлам и ресурсам" Margin="0,5,0,0" FontSize="11.5" Opacity="0.72" TextWrapping="Wrap" Foreground="{DynamicResource WindowForeground}"/>
