                                <UniformGrid Rows="2" Columns="2" Width="68" Height="68" HorizontalAlignment="Center">
                                    <Border x:Name="CleanupLoadingSquareA" Style="{StaticResource CoreLoadingSquareStyle}"/>
                                    <Border x:Name="CleanupLoadingSquareB" Style="{StaticResource CoreLoadingSquareStyle}"/>
                                    <Border x:Name="CleanupLoadingSquareC" Style="{StaticResource CoreLoadingSquareStyle}"/>
                                    <Border x:Name="CleanupLoadingSquareD" Style="{StaticResource CoreLoadingSquareStyle}"/>
                                </UniformGrid>
                                <TextBlock x:Name="CleanupProgressTextBlock" Text="Очистка выполняется" Margin="0,16,0,0" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource WindowForeground}"/>
                                <ProgressBar x:Name="CleanupProgressBar" Width="220" Height="8" Margin="0,16,0,0" IsIndeterminate="True" Foreground="{DynamicResource CoreLineActiveBrush}" Background="{DynamicResource CardBackground}" BorderThickness="0"/>
