                                           Margin="0,14,0,0"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Opacity="0.72"
                                           Foreground="{DynamicResource WindowForeground}"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
