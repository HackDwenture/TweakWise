                                                     PreviewMouseLeftButtonUp="ExpandedCore_MouseLeftButtonUp"/>

                        <Border x:Name="DetailsHeaderCard" Canvas.Left="358" Canvas.Top="0" Width="384" Style="{StaticResource GlassCardStyle}" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="HeaderCardTranslate"/>
                            </Border.RenderTransform>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Расширенное ядро" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}" VerticalAlignment="Center"/>
                                    <Button x:Name="CheckSystemButton" Grid.Column="1" Style="{StaticResource DockSecondaryButtonStyle}" Padding="10,6" Click="CheckSystemButton_Click">
