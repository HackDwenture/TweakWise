                                           FontSize="12"
                                           LineHeight="17"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap"
                                           Opacity="0.76"
                                           Foreground="{DynamicResource WindowForeground}"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="DetailsMonitorCard" Canvas.Left="18" Canvas.Top="148" Width="300" Height="96" Style="{StaticResource CoreDetailTabButtonStyle}" Tag="Monitor" Click="CoreDetailTabButton_Click" Opacity="0">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="MonitorCardTranslate"/>
                            </Button.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="13" Background="#1D4EA8FF" BorderBrush="{DynamicResource CoreLineActiveBrush}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WindowForeground}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Быстрый мониторинг" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}"/>
                                    <TextBlock Text="Нагрузка, память, диск и сессия" Margin="0,5,0,0" FontSize="11.5" Opacity="0.72" TextWrapping="Wrap" Foreground="{DynamicResource WindowForeground}"/>
                                    <TextBlock x:Name="MonitorMiniValueTextBlock" Text="Сбор данных" Margin="0,8,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource CoreLineActiveBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="DetailsDiagnosticsCard" Canvas.Left="18" Canvas.Top="262" Width="300" Height="96" Style="{StaticResource CoreDetailTabButtonStyle}" Tag="Diagnostics" Click="CoreDetailTabButton_Click" Opacity="0">
