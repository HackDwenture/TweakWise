<Page x:Class="TweakWise.Pages.CoreHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:TweakWise.Controls"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      Background="{DynamicResource WindowBackground}">
    <Page.Resources>
        <Style x:Key="CorePanelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CorePanelButtonStyle}">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
        </Style>

        <Style x:Key="DockSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DockActionButtonStyle}">
            <Setter Property="Opacity" Value="0.92"/>
        </Style>

        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.18" Color="#05080D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="MetricIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#1D4EA8FF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CoreLoadingSquareStyle" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNormalBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.42" Color="#3CC7B7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoreDetailTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanupProfileToggleStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <Border x:Name="Root"
                                Width="66"
                                MinHeight="58"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="8,8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="9" Background="#173CC7B7" BorderBrush="{DynamicResource CoreLineActiveBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource WindowForeground}"/>
                                </Border>
                                <TextBlock Text="{TemplateBinding Content}" Margin="0,7,0,0" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#223CC7B7"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#3CC7B7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="14"
                                         Height="14"
                                         Margin="3,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource WindowForeground}"
                                         Opacity="0.62"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="White"/>
                                <Setter TargetName="SwitchThumb" Property="Opacity" Value="1"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28,22,28,18" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                <TextBlock x:Name="LastCheckTextBlock"
                           FontSize="13"
                           Opacity="0.72"
                           Foreground="{DynamicResource WindowForeground}"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="HeaderStatusTextBlock"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           Foreground="{DynamicResource WindowForeground}"/>
                <TextBlock x:Name="HeaderCountersTextBlock"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Opacity="0.72"
                           TextAlignment="Right"
                           Foreground="{DynamicResource WindowForeground}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0"
                     Stretch="Uniform"
                     MaxWidth="1220"
                     MaxHeight="670"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Canvas x:Name="MapLayer"
                        Width="1100"
                        Height="610"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                    </Canvas.RenderTransform>

                    <Canvas x:Name="CircuitTextureLayer"
                            IsHitTestVisible="False"
                            Opacity="0.58">
                        <Canvas.Resources>
                            <Style TargetType="Polyline">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
                                <Setter Property="StrokeThickness" Value="1.05"/>
                                <Setter Property="Opacity" Value="0.32"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                            <Style TargetType="Line">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
                                <Setter Property="StrokeThickness" Value="0.95"/>
                                <Setter Property="Opacity" Value="0.24"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
                                <Setter Property="StrokeThickness" Value="0.95"/>
                                <Setter Property="Opacity" Value="0.20"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                        </Canvas.Resources>

                        <Ellipse Canvas.Left="412" Canvas.Top="232" Width="276" Height="276" Opacity="0.18"/>
                        <Ellipse Canvas.Left="354" Canvas.Top="174" Width="392" Height="392" StrokeDashArray="10,10" Opacity="0.22"/>
                        <Ellipse Canvas.Left="298" Canvas.Top="118" Width="504" Height="504" Opacity="0.12"/>

                        <Line X1="550" Y1="28" X2="550" Y2="612" Opacity="0.14"/>
                        <Line X1="70" Y1="370" X2="1030" Y2="370" Opacity="0.14"/>
                        <Line X1="245" Y1="30" X2="245" Y2="610" Opacity="0.10"/>
                        <Line X1="855" Y1="30" X2="855" Y2="610" Opacity="0.10"/>
                        <Line X1="120" Y1="160" X2="980" Y2="160" Opacity="0.08"/>
                        <Line X1="120" Y1="505" X2="980" Y2="505" Opacity="0.08"/>

                        <Polyline Points="78,88 245,88 245,174 330,174 330,238 438,238"/>
                        <Polyline Points="92,538 245,538 245,488 338,488 338,452 442,452"/>
                        <Polyline Points="1012,88 855,88 855,174 770,174 770,238 662,238"/>
                        <Polyline Points="1018,538 855,538 855,488 762,488 762,452 658,452"/>
                        <Polyline Points="58,304 314,304 314,330 442,330"/>
                        <Polyline Points="1042,304 786,304 786,330 658,330"/>
                        <Polyline Points="132,226 398,226 398,280 465,280"/>
                        <Polyline Points="968,226 702,226 702,280 635,280"/>
                        <Polyline Points="132,452 390,452 390,422 445,422"/>
                        <Polyline Points="968,452 710,452 710,422 655,422"/>

                        <Ellipse Canvas.Left="241" Canvas.Top="84" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                        <Ellipse Canvas.Left="326" Canvas.Top="234" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                        <Ellipse Canvas.Left="851" Canvas.Top="84" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                        <Ellipse Canvas.Left="766" Canvas.Top="234" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                        <Ellipse Canvas.Left="241" Canvas.Top="534" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                        <Ellipse Canvas.Left="851" Canvas.Top="534" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                        <Ellipse Canvas.Left="310" Canvas.Top="300" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                        <Ellipse Canvas.Left="782" Canvas.Top="300" Width="8" Height="8" Fill="{DynamicResource CoreLineBrush}" Opacity="0.32"/>
                    </Canvas>

                    <Canvas x:Name="ConnectionLineLayer" IsHitTestVisible="False">
                        <Canvas.Resources>
                            <Style x:Key="BaseConnectionLineStyle" TargetType="Line">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
                                <Setter Property="StrokeThickness" Value="1.35"/>
                                <Setter Property="Opacity" Value="0.30"/>
                                <Setter Property="StrokeStartLineCap" Value="Round"/>
                                <Setter Property="StrokeEndLineCap" Value="Round"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                            <Style x:Key="ActiveConnectionLineStyle" TargetType="Line">
                                <Setter Property="Stroke" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter Property="StrokeThickness" Value="2.25"/>
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="StrokeDashArray" Value="140,500"/>
                                <Setter Property="StrokeDashOffset" Value="140"/>
                                <Setter Property="StrokeDashCap" Value="Round"/>
                                <Setter Property="StrokeStartLineCap" Value="Round"/>
                                <Setter Property="StrokeEndLineCap" Value="Round"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#4AA9FF"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Canvas.Resources>

                        <Line X1="550" Y1="116" X2="550" Y2="284" Style="{StaticResource BaseConnectionLineStyle}"/>
                        <Line X1="340" Y1="207" X2="482" Y2="317" Style="{StaticResource BaseConnectionLineStyle}"/>
                        <Line X1="340" Y1="427" X2="467" Y2="392" Style="{StaticResource BaseConnectionLineStyle}"/>
                        <Line X1="550" Y1="512" X2="550" Y2="456" Style="{StaticResource BaseConnectionLineStyle}"/>
                        <Line X1="760" Y1="207" X2="618" Y2="317" Style="{StaticResource BaseConnectionLineStyle}"/>
                        <Line X1="760" Y1="427" X2="633" Y2="392" Style="{StaticResource BaseConnectionLineStyle}"/>

                        <Line x:Name="WindowsSetupActiveLine" X1="550" Y1="116" X2="550" Y2="284" Style="{StaticResource ActiveConnectionLineStyle}"/>
                        <Line x:Name="SystemParametersActiveLine" X1="340" Y1="207" X2="482" Y2="317" Style="{StaticResource ActiveConnectionLineStyle}"/>
                        <Line x:Name="StorageActiveLine" X1="340" Y1="427" X2="467" Y2="392" Style="{StaticResource ActiveConnectionLineStyle}"/>
                        <Line x:Name="NetworkActiveLine" X1="550" Y1="512" X2="550" Y2="456" Style="{StaticResource ActiveConnectionLineStyle}"/>
                        <Line x:Name="ResourcesActiveLine" X1="760" Y1="207" X2="618" Y2="317" Style="{StaticResource ActiveConnectionLineStyle}"/>
                        <Line x:Name="DevicesActiveLine" X1="760" Y1="427" X2="633" Y2="392" Style="{StaticResource ActiveConnectionLineStyle}"/>
                    </Canvas>

                    <controls:SystemCoreControl x:Name="MainCore"
                                                 Canvas.Left="432"
                                                 Canvas.Top="252"
                                                 Width="236"
                                                 Height="236"
                                                 Cursor="Hand"
                                                 PreviewMouseLeftButtonUp="MainCore_MouseLeftButtonUp"
                                                 MouseEnter="MainCore_MouseEnter"
                                                 MouseLeave="MainCore_MouseLeave"/>

                    <controls:CoreModuleNodeControl x:Name="WindowsSetupNode" Canvas.Left="410" Canvas.Top="38" Width="280" Height="78" MouseLeftButtonUp="ModuleNode_MouseLeftButtonUp"
                                                    MouseEnter="ModuleNode_MouseEnter"
                                                    MouseLeave="ModuleNode_MouseLeave"/>
                    <controls:CoreModuleNodeControl x:Name="SystemParametersNode" Canvas.Left="58" Canvas.Top="168" Width="282" Height="78" MouseLeftButtonUp="ModuleNode_MouseLeftButtonUp"
                                                    MouseEnter="ModuleNode_MouseEnter"
                                                    MouseLeave="ModuleNode_MouseLeave"/>
                    <controls:CoreModuleNodeControl x:Name="StorageNode" Canvas.Left="58" Canvas.Top="388" Width="282" Height="78" MouseLeftButtonUp="ModuleNode_MouseLeftButtonUp"
                                                    MouseEnter="ModuleNode_MouseEnter"
                                                    MouseLeave="ModuleNode_MouseLeave"/>
                    <controls:CoreModuleNodeControl x:Name="NetworkNode" Canvas.Left="410" Canvas.Top="512" Width="280" Height="78" MouseLeftButtonUp="ModuleNode_MouseLeftButtonUp"
                                                    MouseEnter="ModuleNode_MouseEnter"
                                                    MouseLeave="ModuleNode_MouseLeave"/>
                    <controls:CoreModuleNodeControl x:Name="ResourcesNode" Canvas.Left="760" Canvas.Top="168" Width="282" Height="78" MouseLeftButtonUp="ModuleNode_MouseLeftButtonUp"
                                                    MouseEnter="ModuleNode_MouseEnter"
                                                    MouseLeave="ModuleNode_MouseLeave"/>
                    <controls:CoreModuleNodeControl x:Name="DevicesNode" Canvas.Left="760" Canvas.Top="388" Width="282" Height="78" MouseLeftButtonUp="ModuleNode_MouseLeftButtonUp"
                                                    MouseEnter="ModuleNode_MouseEnter"
                                                    MouseLeave="ModuleNode_MouseLeave"/>

                    <Border x:Name="HomeActionDock"
                            Canvas.Left="392"
                            Canvas.Top="122"
                            Width="316"
                            Background="{DynamicResource CoreNodeBackgroundBrush}"
                            BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14,12"
                            MaxHeight="118"
                            Visibility="Collapsed"
                            Opacity="0.98">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HomeActionTitleTextBlock" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CoreLineActiveBrush}" Text="Плановая очистка"/>
                                <Border x:Name="CleanupRecommendationBadge" Grid.Column="1" Margin="12,0,0,0" Padding="8,4" CornerRadius="9" Background="#173CC7B7" BorderBrush="{DynamicResource CoreLineActiveBrush}" BorderThickness="1" Visibility="Collapsed">
                                    <TextBlock x:Name="CleanupRecommendationTextBlock" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}" TextWrapping="NoWrap"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="HomeActionDescriptionTextBlock" Margin="0,7,0,0" FontSize="11.2" LineHeight="14.5" Opacity="0.78" TextWrapping="Wrap" Foreground="{DynamicResource WindowForeground}"/>
                            <StackPanel x:Name="CleanupRecommendationActionsPanel" Margin="0,10,0,0" Orientation="Horizontal" Visibility="Collapsed">
                                <Button x:Name="OpenCleanupRecommendationButton" Style="{StaticResource DockActionButtonStyle}" Padding="11,6" Margin="0,0,8,0" Click="OpenCleanupRecommendationButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                        <TextBlock Text="Открыть"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DismissCleanupRecommendationButton" Style="{StaticResource DockSecondaryButtonStyle}" Padding="11,6" Click="DismissCleanupRecommendationButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                        <TextBlock Text="Позже"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Viewbox>

            <Border x:Name="TemperatureDock"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    MaxWidth="760"
                    MinWidth="420"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18,10"
                    Opacity="0.96">
                <TextBlock x:Name="TemperatureDockTextBlock"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource WindowForeground}"/>
            </Border>

            <Grid x:Name="CoreDetailsLayer"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.52">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CoreDetailsScale" ScaleX="0.88" ScaleY="0.88"/>
                </Grid.RenderTransform>

                <Border Background="{DynamicResource WindowBackground}" Opacity="0.96"/>

                <Viewbox Stretch="Uniform" MaxWidth="1120" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="1100" Height="620">
                        <Canvas IsHitTestVisible="False" Opacity="0.52">
                            <Canvas.Resources>
                                <Style TargetType="Line">
                                    <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
                                    <Setter Property="StrokeThickness" Value="0.95"/>
                                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                                    <Setter Property="StrokeEndLineCap" Value="Round"/>
                                </Style>
                                <Style TargetType="Polyline">
                                    <Setter Property="Stroke" Value="{DynamicResource CoreLineActiveBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.1"/>
                                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                                    <Setter Property="StrokeEndLineCap" Value="Round"/>
                                    <Setter Property="StrokeLineJoin" Value="Round"/>
                                    <Setter Property="Fill" Value="Transparent"/>
                                </Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource CoreLineActiveBrush}"/>
                                    <Setter Property="Width" Value="6"/>
                                    <Setter Property="Height" Value="6"/>
                                    <Setter Property="Opacity" Value="0.66"/>
                                </Style>
                            </Canvas.Resources>

                            <Line X1="212" Y1="96" X2="888" Y2="96" Opacity="0.08"/>
                            <Line X1="176" Y1="318" X2="924" Y2="318" Opacity="0.10"/>
                            <Line X1="212" Y1="548" X2="888" Y2="548" Opacity="0.08"/>
                            <Line X1="550" Y1="72" X2="550" Y2="560" Opacity="0.08"/>
                            <Line X1="390" Y1="122" X2="390" Y2="510" Opacity="0.07"/>
