<Page x:Class="TweakWise.Pages.WorkEnvironmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="clr-namespace:TweakWise.Models"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      PreviewKeyDown="Page_PreviewKeyDown"
      Title="Рабочая среда"
      Focusable="True"
      Background="{DynamicResource WindowBackground}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardPartHitStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardNodeGlowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="BoardPartShellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.25"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Opacity" Value="0.97"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.14" Color="#05080D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BoardSmallLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.76"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BoardTraceLineStyle" TargetType="Line">
            <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
            <Setter Property="StrokeThickness" Value="0.95"/>
            <Setter Property="Opacity" Value="0.18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardTracePolylineStyle" TargetType="Polyline">
            <Setter Property="Stroke" Value="{DynamicResource CoreLineBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Opacity" Value="0.20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BoardOutlineStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="StrokeThickness" Value="1.15"/>
            <Setter Property="Opacity" Value="0.28"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style x:Key="DiagnosticCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#05080D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="EnvironmentSearchBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="40,0,40,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="SearchHighlightGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#254EA8FF" Offset="0"/>
            <GradientStop Color="#343CC7B7" Offset="0.46"/>
            <GradientStop Color="#1BFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="EnvironmentLoadingSquareStyle" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNormalBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.42" Color="#3CC7B7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoardToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MaxWidth" Value="300"/>
        </Style>

        <Style x:Key="EnvironmentActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnvironmentPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource EnvironmentActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CoreOrbForegroundBrush}"/>
        </Style>

        <Style x:Key="EnvironmentSignalActionButtonStyle" TargetType="Button" BasedOn="{StaticResource EnvironmentActionButtonStyle}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
        </Style>

        <Style x:Key="EnvironmentSettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.12" Color="#05080D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnvironmentBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="EnvironmentFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CoreLineActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnvironmentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background" Value="{DynamicResource CoreNodeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreNodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                MinHeight="34"
                                                Background="{DynamicResource CoreNodeBackgroundBrush}"
                                                BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="10,6">
                                            <Grid>
                                                <TextBlock Margin="0,0,22,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource WindowForeground}"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.72"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.48"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="{DynamicResource ContentBackground}"
                                        BorderBrush="{DynamicResource CoreLineActiveBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource WindowForeground}"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnvironmentToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="56" Height="30" SnapsToDevicePixels="True">
                            <Border x:Name="Track"
                                    Width="54"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Fill="{DynamicResource WindowForeground}"
                                     Margin="5,0,5,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnergyOrbButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource CoreOrbForegroundBrush}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush Center="0.44,0.38" GradientOrigin="0.36,0.30" RadiusX="0.78" RadiusY="0.78">
                        <GradientStop Color="#F14FE8D8" Offset="0"/>
                        <GradientStop Color="#C531B9D0" Offset="0.44"/>
                        <GradientStop Color="#702D6EA7" Offset="0.78"/>
                        <GradientStop Color="#25203B54" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource CoreLineActiveBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Margin="-7,24,-7,-9" Opacity="0.22">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.66" RadiusY="0.42">
                                        <GradientStop Color="#7A4FE8D8" Offset="0"/>
                                        <GradientStop Color="#243CC7B7" Offset="0.55"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="OuterRing" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" Opacity="0.34"/>
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.34" Color="#3CC7B7"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Margin="9" Opacity="0.24">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.36,0.30" GradientOrigin="0.22,0.18" RadiusX="0.92" RadiusY="0.92">
                                        <GradientStop Color="#D8FFFFFF" Offset="0"/>
                                        <GradientStop Color="#7A5DEBE2" Offset="0.30"/>
                                        <GradientStop Color="#2835A7C8" Offset="0.72"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Margin="14,10,19,23" Fill="#DFFFFFFF" Opacity="0.32"/>
                            <Ellipse Margin="20,20,15,15" Fill="#7EE9FFF7" Opacity="0.18"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootContent" Background="{DynamicResource WindowBackground}" ClipToBounds="True" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,18,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="&#xE72B;"
                    Style="{StaticResource BackButtonStyle}"
                    ToolTip="Назад на главный экран"
                    Click="BackButton_Click"/>

            <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ModuleStatusIndicator"
                             Width="9"
                             Height="9"
                             Margin="0,1,10,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModuleStatusTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Opacity="0.78"/>
                </StackPanel>
                <TextBlock Text="Рабочая среда"
                           Margin="0,8,0,0"
                           FontSize="25"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Grid.Column="3"
                       Text="Схема рабочего стола, Пуска, панели задач, окон и уведомлений"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Opacity="0.62"/>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,18">
            <Viewbox Stretch="Uniform"
                     MaxWidth="1340"
                     MaxHeight="790"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Canvas x:Name="BoardCanvas" Width="1280" Height="720">
                    <Border Canvas.Left="82"
                            Canvas.Top="50"
                            Width="1056"
                            Height="606"
                            Background="{DynamicResource ContentBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Opacity="0.98">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.16" Color="#05080D"/>
                        </Border.Effect>
                    </Border>

                    <Border Canvas.Left="128"
                            Canvas.Top="94"
                            Width="964"
                            Height="520"
                            Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Opacity="0.36"/>

                    <Canvas x:Name="DesktopLayer" IsHitTestVisible="False">
                        <Rectangle Canvas.Left="154" Canvas.Top="96" Width="912" Height="494" RadiusX="14" RadiusY="14" Style="{StaticResource BoardOutlineStyle}" Opacity="0.24"/>
                        <Rectangle Canvas.Left="206" Canvas.Top="146" Width="808" Height="364" RadiusX="10" RadiusY="10" Style="{StaticResource BoardOutlineStyle}" Opacity="0.14"/>

                        <Line X1="610" Y1="96" X2="610" Y2="590" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.08"/>
                        <Line X1="154" Y1="340" X2="1066" Y2="340" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.10"/>
                        <Line X1="386" Y1="146" X2="386" Y2="510" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.06"/>
                        <Line X1="814" Y1="146" X2="814" Y2="510" Style="{StaticResource BoardTraceLineStyle}" Opacity="0.06"/>

                        <Rectangle Canvas.Left="220" Canvas.Top="190" Width="286" Height="146" RadiusX="12" RadiusY="12" Style="{StaticResource BoardOutlineStyle}" Opacity="0.20"/>
                        <Rectangle Canvas.Left="684" Canvas.Top="236" Width="286" Height="146" RadiusX="12" RadiusY="12" Style="{StaticResource BoardOutlineStyle}" Opacity="0.20"/>
                        <Rectangle Canvas.Left="252" Canvas.Top="384" Width="292" Height="132" RadiusX="12" RadiusY="12" Style="{StaticResource BoardOutlineStyle}" Opacity="0.18"/>
                        <Rectangle Canvas.Left="248" Canvas.Top="526" Width="724" Height="42" RadiusX="12" RadiusY="12" Style="{StaticResource BoardOutlineStyle}" Opacity="0.24"/>

                        <Polyline Points="610,214 610,340" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.18"/>
                        <Polyline Points="472,254 610,254 610,340" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.24"/>
                        <Polyline Points="714,300 610,300 610,340" Style="{StaticResource BoardTracePolylineStyle}" Opacity="0.20"/>
