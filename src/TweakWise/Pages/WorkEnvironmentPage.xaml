                                                            <TextBlock Text="{Binding Source}" FontSize="11" FontWeight="SemiBold" Opacity="0.82"/>
                                                        </Border>
                                                        <Border x:Name="SettingSignalStatusBadge" Style="{StaticResource EnvironmentBadgeStyle}" Visibility="{Binding HasActiveSignal, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock x:Name="SettingSignalStatusLabel" Text="{Binding SignalKindText}" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border x:Name="SettingRiskBadge" Style="{StaticResource EnvironmentBadgeStyle}" Visibility="{Binding RiskVisibility}">
                                                            <TextBlock x:Name="SettingRiskLabel" Text="{Binding RiskLabel}" FontSize="11" FontWeight="SemiBold" Opacity="0.82"/>
                                                        </Border>
                                                        <Border Style="{StaticResource EnvironmentBadgeStyle}">
                                                            <TextBlock Text="{Binding BackupState}" FontSize="11" FontWeight="SemiBold" Opacity="0.82"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" Margin="0,7,0,0" FontSize="12" LineHeight="18" Opacity="0.76" TextWrapping="Wrap"/>
                                                    <Border Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Visibility="{Binding HasCurrentValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <StackPanel>
                                                            <TextBlock Text="Текущее состояние" FontSize="11" FontWeight="SemiBold" Opacity="0.62"/>
                                                            <TextBlock Text="{Binding CurrentValue}" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Recommendation}"
                                                               Margin="0,10,0,0"
                                                               FontSize="12"
                                                               LineHeight="18"
                                                               TextWrapping="Wrap"
                                                               Opacity="0.78"
                                                               Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <CheckBox Style="{StaticResource EnvironmentToggleStyle}"
                                                              Margin="0,12,0,0"
                                                              HorizontalAlignment="Left"
                                                              IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanApply}"
                                                              Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <ComboBox Style="{StaticResource EnvironmentComboBoxStyle}"
                                                              Margin="0,12,0,0"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                              DisplayMemberPath="Label"
                                                              IsEnabled="{Binding CanApply}"
                                                              Visibility="{Binding IsCombo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Border Margin="0,12,0,0"
                                                            Padding="10,8"
                                                            Background="{DynamicResource CoreNodeBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Opacity="0.84"/>
                                                    </Border>
                                                    <WrapPanel Margin="0,14,0,-8">
                                                        <Button Content="{Binding ApplyButtonText}"
                                                                Style="{StaticResource EnvironmentPrimaryActionButtonStyle}"
                                                                IsEnabled="{Binding CanApply}"
                                                                Visibility="{Binding ShowApplyAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Click="ApplyEnvironmentSetting_Click"/>
                                                        <Button Content="Откатить"
                                                                Style="{StaticResource EnvironmentActionButtonStyle}"
                                                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Click="RollbackEnvironmentSetting_Click"/>
                                                        <Button Content="{Binding SignalActionText}"
                                                                Tag="{Binding SignalId}"
                                                                Style="{StaticResource EnvironmentSignalActionButtonStyle}"
                                                                Visibility="{Binding HasActiveSignal, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Click="IgnoreEnvironmentSettingSignal_Click"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="EnvironmentNavigationBusyOverlay"
                            Grid.RowSpan="2"
                            Panel.ZIndex="20"
                            Background="#D91D2A34"
                            BorderBrush="{DynamicResource CoreNodeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed"
                            Opacity="0"
                            IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UniformGrid Rows="2" Columns="2" Width="60" Height="60" HorizontalAlignment="Center">
                                <Border x:Name="EnvironmentBusySquareA" Style="{StaticResource EnvironmentLoadingSquareStyle}"/>
                                <Border x:Name="EnvironmentBusySquareB" Style="{StaticResource EnvironmentLoadingSquareStyle}"/>
                                <Border x:Name="EnvironmentBusySquareC" Style="{StaticResource EnvironmentLoadingSquareStyle}"/>
                                <Border x:Name="EnvironmentBusySquareD" Style="{StaticResource EnvironmentLoadingSquareStyle}"/>
                            </UniformGrid>
                            <TextBlock Text="Загрузка узла, пожалуйста подождите"
                                       Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.76"/>
                            <TextBlock Text="Считываем параметры реестра и подготавливаем доступные действия."
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Opacity="0.56"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="NodeDetailsOrbButton"
                    Style="{StaticResource EnergyOrbButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0"
                    ToolTip="Свернуть узел и вернуться к карте"
                    Visibility="Collapsed"
                    Opacity="0"
                    Click="NodeDetailsOrbButton_Click"
                    RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="NodeDetailsOrbScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="NodeDetailsOrbTranslate"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
        </Grid>
    </Grid>
</Page>
