<Page x:Class="TweakWise.Pages.ModuleWorkspacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:TweakWise.Controls"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      Background="{DynamicResource ContentBackground}">
    <Grid Background="{DynamicResource ContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Назад"
                        Padding="14,8"
                        VerticalAlignment="Top"
                        Click="BackButton_Click"/>

                <controls:SystemCoreControl x:Name="MiniCoreControl"
                                            Grid.Column="2"
                                            Width="128"
                                            Height="128"
                                            VerticalAlignment="Center"/>

                <StackPanel Grid.Column="4"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModuleStatusIndicator"
                                 Width="10"
                                 Height="10"
                                 VerticalAlignment="Center"
                                 Margin="0,1,10,0"/>
                        <TextBlock x:Name="ModuleStatusTextBlock"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Opacity="0.78"/>
                    </StackPanel>

                    <TextBlock x:Name="ModuleTitleTextBlock"
                               Margin="0,10,0,0"
                               FontSize="25"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModuleDescriptionTextBlock"
                               Margin="0,8,0,0"
                               FontSize="14"
                               Opacity="0.76"
                               TextWrapping="Wrap"
                               MaxWidth="720"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="FindingsPanel"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Найдено при проверке"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <ItemsControl x:Name="FindingsItemsControl"
                                  Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,12"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Margin="0,7,0,0"
                                                       FontSize="13"
                                                       Opacity="0.76"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ActionText}"
                                                       Margin="0,8,0,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.72"
                                                   Margin="24,1,0,0"/>
                                        <Button Grid.Column="1"
                                                Content="Игнорировать"
                                                Margin="24,28,0,0"
                                                Padding="10,5"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource DialogActionButtonStyle}"
                                                Tag="{Binding Id}"
                                                Click="IgnoreFindingButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="Секции модуля"
                       Margin="0,22,0,0"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <ScrollViewer Grid.Row="2"
                          Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SectionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StatusText}"
                                               FontSize="12"
                                               Opacity="0.66"
                                               Margin="24,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
