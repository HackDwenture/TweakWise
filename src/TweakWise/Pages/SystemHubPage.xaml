<Page x:Class="TweakWise.Pages.SystemHubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Система"
      Background="{DynamicResource ContentBackground}">
    <ScrollViewer Padding="20"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CatalogSectionBorderStyle}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Система"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Здесь будут системные настройки Windows, сгруппированные по смыслу."
                               Margin="0,10,0,0"
                               Opacity="0.84"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="SectionsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CatalogSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Настройки будут добавлены позже."
                                           Margin="0,8,0,0"
                                           Opacity="0.82"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
