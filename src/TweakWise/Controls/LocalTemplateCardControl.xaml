<UserControl x:Class="TweakWise.Controls.LocalTemplateCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TweakWise.Controls"
             x:Name="Root">
    <Border Style="{StaticResource CatalogTemplateCardBorderStyle}">
        <StackPanel>
            <Border Background="{DynamicResource ButtonHoverBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Padding="16,14,16,12">
                <StackPanel>
                    <controls:CatalogBadgeControl Text="Готовый сценарий"
                                                 Tone="Info"/>

                    <TextBlock Text="{Binding TemplateCard.Title, ElementName=Root}"
                               Margin="0,12,0,0"
                               FontSize="19"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding TemplateCard.Description, ElementName=Root}"
                               Margin="0,8,0,0"
                               Opacity="0.84"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="16">
                <WrapPanel>
                    <controls:CatalogBadgeControl Text="{Binding TemplateCard.RiskBadgeText, ElementName=Root}"
                                                 Tone="{Binding TemplateCard.RiskTone, ElementName=Root}"/>
                    <controls:CatalogBadgeControl Text="{Binding TemplateCard.RestartBadgeText, ElementName=Root}"
                                                 Tone="{Binding TemplateCard.RestartTone, ElementName=Root}"/>
                </WrapPanel>

                <Border Style="{StaticResource CatalogSubtlePanelStyle}"
                        Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Где применяется"
                                   Style="{StaticResource CatalogStateTitleTextStyle}"/>
                        <TextBlock Text="{Binding TemplateCard.ScopeText, ElementName=Root}"
                                   Margin="0,6,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding TemplateCard.AudienceText, ElementName=Root}"
                           Margin="0,10,0,0"
                           Opacity="0.82"
                           TextWrapping="Wrap"/>

                <StackPanel Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TemplateCard.HasIncludedItems, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Что входит в сценарий"
                               FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding TemplateCard.IncludedItems, ElementName=Root}"
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CatalogListItemTextStyle}"
                                           Text="{Binding ., StringFormat=• {0}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <DockPanel Margin="0,14,0,0"
                           LastChildFill="False">
                    <TextBlock Text="Можно донастроить внутри раздела"
                               Opacity="0.74"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="Применить"
                            DockPanel.Dock="Right"
                            Style="{StaticResource CatalogSecondaryActionButtonStyle}"
                            ToolTip="Откроет раздел со связанными настройками"
                            Click="ApplyButton_Click"/>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
