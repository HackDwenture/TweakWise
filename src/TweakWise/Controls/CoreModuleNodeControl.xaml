<UserControl x:Class="TweakWise.Controls.CoreModuleNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="286"
             Height="78"
             Focusable="True"
             Cursor="Hand"
             MouseEnter="Root_MouseEnter"
             MouseLeave="Root_MouseLeave"
             MouseLeftButtonUp="Root_MouseLeftButtonUp"
             KeyDown="Root_KeyDown">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="NodeScale" ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>

    <Border x:Name="NodeRoot"
            Background="{DynamicResource CoreNodeBackgroundBrush}"
            BorderBrush="{DynamicResource CoreNodeBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="23"
            Padding="18,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.12"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="13"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="StatusIndicator"
                     Width="10"
                     Height="10"
                     VerticalAlignment="Top"
                     Margin="0,5,0,0"/>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           FontSize="14"
                           FontWeight="SemiBold"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="38"/>

                <TextBlock x:Name="HintTextBlock"
                           Visibility="Collapsed"/>

                <TextBlock Grid.Row="1"
                           x:Name="StatusTextBlock"
                           Margin="0,7,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Opacity="0.82"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <TextBlock Grid.Column="3"
                       Text="›"
                       FontSize="22"
                       FontWeight="Light"
                       Opacity="0.58"
                       Margin="12,-1,0,0"
                       VerticalAlignment="Top"/>
        </Grid>
    </Border>
</UserControl>
